<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Findra</RootNamespace>
    <AssemblyName>findra</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- System.IO.Pipes.AccessControl (below) carries the PipeSecurity the helper puts on
         its listener, and 5.0.0 is the only stable release NuGet has ever published
         for it, so restore always flags NU1510 ("will not be pruned"). Per-package
         suppression via NoWarn metadata on the PackageReference item (both attribute
         and child-element form) does not silence NU1510 on this SDK - verified by
         testing both against a clean restore - so it is suppressed at project level
         here instead, scoped to just this one warning code. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Microsoft.Data.Sqlite pulls this transitively, and it carries the native SQLite build -
         the one that decides whether FTS5 exists at all. Pinned for the same reason SkiaSharp
         is: a transitive NATIVE dependency that drifts on a restore is a binary swap nobody
         reviewed. It ships win-x64, win-x86 and win-arm64, so nothing here assumes x64. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <!-- Avalonia.Skia pins a specific SkiaSharp version, and two SkiaSharp majors in one
         process means two native libSkiaSharp binaries. Pinned here ahead of Avalonia
         landing so the palette's colour type never has to move once the UI arrives. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
</Project>
